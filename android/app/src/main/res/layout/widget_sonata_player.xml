<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="8dp"
    android:paddingBottom="6dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Main pastel blush-pink retro window frame -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_frame_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Retro title bar: "sonata player" + window control buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_window_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="sonata player"
                android:textColor="#5D3243"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Retro window buttons: — □ × -->
            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_win_btn_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="_"
                android:textColor="#5D3243"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/widget_win_btn_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="□"
                android:textColor="#5D3243"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/widget_win_btn_bg"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="×"
                android:textColor="#5D3243"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Framed pixel-art vinyl turntable scene -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_scene_frame"
            android:padding="2dp">

            <ImageView
                android:id="@+id/widget_turntable_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Sonata pixel art turntable"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_turntable_scene" />
        </FrameLayout>

        <!-- Inner blush-cream panel with Now Playing info, transport buttons & star progress bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_inner_panel"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- Album art + "now playing.." + title + "by artist" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/widget_scene_frame"
                    android:padding="1.5dp">

                    <ImageView
                        android:id="@+id/widget_album_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Album cover"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_foreground_img" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="now playing.."
                        android:textColor="#8E5B6F"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/widget_track_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="Sonata"
                        android:textColor="#472133"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_track_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="by Tap to play"
                        android:textColor="#7D4C60"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3 Chunky retro pastel transport buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_bg"
                    android:contentDescription="Previous track"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_prev" />

                <ImageButton
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/widget_btn_bg"
                    android:contentDescription="Play or pause"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_play" />

                <ImageButton
                    android:id="@+id/widget_btn_next"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_bg"
                    android:contentDescription="Next track"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_icon_next" />
            </LinearLayout>

            <!-- Star progress bar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="8dp">

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_gravity="center_vertical"
                    android:max="100"
                    android:progress="42"
                    android:progressDrawable="@drawable/widget_progress_bar" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_pixel_star" />
            </FrameLayout>

            <!-- Elapsed & remaining timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="0:00"
                    android:textColor="#8E5B6F"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_time_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0:00"
                    android:textColor="#8E5B6F"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Cute pixel bow perched on the top-center border -->
    <ImageView
        android:layout_width="34dp"
        android:layout_height="22dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/widget_pixel_bow" />

    <!-- Cute pixel heart perched on the bottom-center border -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/widget_pixel_heart" />
</FrameLayout>
